# Railway Postgres Database (Conexión a DB de Railway - solicitar credenciales o usar local)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@altaria.proxy.rlwy.net:23673/railway"
DIRECT_URL="postgresql://postgres:TU_PASSWORD@altaria.proxy.rlwy.net:23673/railway"

JWT_SECRET="dev-jwt-secret-change-in-production"
API_PORT=3001
NODE_ENV=development

# Google OAuth (Solicitar credenciales de Google Cloud Console o usar login email/password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
FRONTEND_URL=http://localhost:5173

# OpenAI (Opcional para desarrollo general, requerido para generación de piezas con IA)
OPENAI_API_KEY=

# Anthropic (Opcional)
ANTHROPIC_API_KEY=

# Apify (Opcional)
APIFY_TOKEN=

# Resend Email Service (Opcional para notificaciones)
RESEND_API_KEY=
RESEND_FROM="ROCKY Platform <notificaciones@ontherocks.tech>"
